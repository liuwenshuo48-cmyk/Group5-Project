<?xml version="1.0"?>
<!--
  Experiment 3 - Group 5 sorting simulation world

  Grid 1-3 : Square (gum boxes)
  Grid 4-6 : Circle (tape rolls)

  Bin 1 : Square
  Bin 2 : Circle

  Table top z = 0.750 m
-->
<sdf version="1.8">
  <world name="grasp_world">

    <physics name="default" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>

    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- Experiment 3 RGB camera sensor support -->
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="c">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>

        <visual name="v">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ================================================= -->
    <!-- Visible 2x3 Grid markers - visual only, no collision -->
    <!-- ================================================= -->

    <model name="grid_markers">
      <static>true</static>
      <link name="grid_visuals">

        <!-- Grid 1 -->
        <visual name="grid1">
          <pose>0.10 0.06 0.751 0 0 0</pose>
          <geometry><box><size>0.058 0.058 0.002</size></box></geometry>
          <material>
            <ambient>0.45 0.70 0.95 0.75</ambient>
            <diffuse>0.45 0.70 0.95 0.75</diffuse>
          </material>
        </visual>

        <!-- Grid 2 -->
        <visual name="grid2">
          <pose>0.10 0.00 0.751 0 0 0</pose>
          <geometry><box><size>0.058 0.058 0.002</size></box></geometry>
          <material>
            <ambient>0.45 0.70 0.95 0.75</ambient>
            <diffuse>0.45 0.70 0.95 0.75</diffuse>
          </material>
        </visual>

        <!-- Grid 3 -->
        <visual name="grid3">
          <pose>0.10 -0.06 0.751 0 0 0</pose>
          <geometry><box><size>0.058 0.058 0.002</size></box></geometry>
          <material>
            <ambient>0.45 0.70 0.95 0.75</ambient>
            <diffuse>0.45 0.70 0.95 0.75</diffuse>
          </material>
        </visual>

        <!-- Grid 4 -->
        <visual name="grid4">
          <pose>0.16 0.06 0.751 0 0 0</pose>
          <geometry><box><size>0.058 0.058 0.002</size></box></geometry>
          <material>
            <ambient>0.45 0.85 0.55 0.75</ambient>
            <diffuse>0.45 0.85 0.55 0.75</diffuse>
          </material>
        </visual>

        <!-- Grid 5 -->
        <visual name="grid5">
          <pose>0.16 0.00 0.751 0 0 0</pose>
          <geometry><box><size>0.058 0.058 0.002</size></box></geometry>
          <material>
            <ambient>0.45 0.85 0.55 0.75</ambient>
            <diffuse>0.45 0.85 0.55 0.75</diffuse>
          </material>
        </visual>

        <!-- Grid 6 -->
        <visual name="grid6">
          <pose>0.16 -0.06 0.751 0 0 0</pose>
          <geometry><box><size>0.058 0.058 0.002</size></box></geometry>
          <material>
            <ambient>0.45 0.85 0.55 0.75</ambient>
            <diffuse>0.45 0.85 0.55 0.75</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- ================= TABLE ================= -->

    <model name="table">
      <static>true</static>
      <pose>0.1 0 0.375 0 0 0</pose>

      <link name="table_link">
        <collision name="c">
          <geometry>
            <box><size>0.9 0.7 0.75</size></box>
          </geometry>
        </collision>

        <visual name="v">
          <geometry>
            <box><size>0.9 0.7 0.75</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.45 0.3 1</ambient>
            <diffuse>0.6 0.45 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- GRID 1 : dark-blue Square, 5 x 1.5 x 9 cm -->
    <!-- ================================================= -->

    <model name="grid1_square">
      <pose>0.10 0.06 0.780 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>3.46875e-5</ixx>
            <iyy>4.41667e-5</iyy>
            <izz>1.13542e-5</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="c">
          <geometry>
            <box><size>0.050 0.025 0.060</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="v">
          <geometry>
            <box><size>0.050 0.025 0.060</size></box>
          </geometry>
          <material>
            <ambient>0.03 0.08 0.45 1</ambient>
            <diffuse>0.03 0.08 0.45 1</diffuse>
          </material>
        </visual>
      

</link>
    </model>

    <!-- GRID 2 : dark-blue Square -->

    <model name="grid2_square">
      <pose>0.10 0.00 0.780 0 0 0</pose>
      <link name="body">
        <inertial><mass>0.05</mass></inertial>

        <collision name="c">
          <geometry>
            <box><size>0.050 0.025 0.060</size></box>
          </geometry>
        </collision>

        <visual name="v">
          <geometry>
            <box><size>0.050 0.025 0.060</size></box>
          </geometry>
          <material>
            <ambient>0.03 0.08 0.45 1</ambient>
            <diffuse>0.03 0.08 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- GRID 3 : light-blue Square -->

    <model name="grid3_square">
      <pose>0.10 -0.06 0.780 0 0 0</pose>
      <link name="body">
        <inertial><mass>0.05</mass></inertial>

        <collision name="c">
          <geometry>
            <box><size>0.050 0.025 0.060</size></box>
          </geometry>
        </collision>

        <visual name="v">
          <geometry>
            <box><size>0.050 0.025 0.060</size></box>
          </geometry>
          <material>
            <ambient>0.20 0.55 0.95 1</ambient>
            <diffuse>0.20 0.55 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- GRID 4 : gray Circle / tape roll -->
    <!-- Cylinder rotated 90 deg so it stands on its edge -->
    <!-- diameter 4 cm, width 1.8 cm -->
    <!-- ================================================= -->

    <model name="grid4_circle">
      <pose>0.16 0.06 0.770 1.5708 0 0</pose>
      <link name="body">
        <inertial><mass>0.03</mass></inertial>

        <collision name="c">
          <geometry>
            <cylinder>
              <radius>0.020</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- G4 real annular tape visual -->
        <visual name="real_tape_ring">
          <geometry>
            <mesh>
              <uri>model://tape_ring/meshes/tape_ring.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.78 0.78 0.78 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
</link>
    </model>

    <!-- GRID 5 : green Circle / tape roll, width 1.2 cm -->

    <model name="grid5_circle">
      <pose>0.16 0.00 0.770 1.5708 0 0</pose>
      <link name="body">
        <inertial><mass>0.03</mass></inertial>

        <collision name="c">
          <geometry>
            <cylinder>
              <radius>0.020</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- G4 real annular tape visual -->
        <visual name="real_tape_ring">
          <geometry>
            <mesh>
              <uri>model://tape_ring/meshes/tape_ring.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.78 0.78 0.78 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
</link>
    </model>

    <!-- GRID 6 : green Circle / tape roll, width 1.2 cm -->

    <model name="grid6_circle">
      <pose>0.16 -0.06 0.770 1.5708 0 0</pose>
      <link name="body">
        <inertial><mass>0.03</mass></inertial>

        <collision name="c">
          <geometry>
            <cylinder>
              <radius>0.020</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- G4 real annular tape visual -->
        <visual name="real_tape_ring">
          <geometry>
            <mesh>
              <uri>model://tape_ring/meshes/tape_ring.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.78 0.78 0.78 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
</link>
    </model>

    <!-- ================================================= -->
    <!-- BIN 1 : Square classification zone -->
    <!-- ================================================= -->

    <model name="square_bin">
      <static>true</static>
      <pose>0.06 0.13 0.7505 0 0 0</pose>
      <link name="body">
        <collision name="c">
          <geometry>
            <box><size>0.12 0.10 0.001</size></box>
          </geometry>
        </collision>

        <visual name="v">
          <geometry>
            <box><size>0.12 0.10 0.001</size></box>
          </geometry>
          <material>
            <ambient>0.66 0.58 0.47 1</ambient>
            <diffuse>0.66 0.58 0.47 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- BIN 2 : Circle classification zone -->

    <model name="circle_bin">
      <static>true</static>
      <pose>0.06 -0.13 0.7505 0 0 0</pose>
      <link name="body">
        <collision name="c">
          <geometry>
            <box><size>0.12 0.10 0.001</size></box>
          </geometry>
        </collision>

        <visual name="v">
          <geometry>
            <box><size>0.12 0.10 0.001</size></box>
          </geometry>
          <material>
            <ambient>0.66 0.58 0.47 1</ambient>
            <diffuse>0.66 0.58 0.47 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Experiment 3 fixed overhead RGB simulation camera -->
    <model name="experiment3_overhead_camera">
      <static>true</static>

      <!-- Camera is above the table and points vertically downward. -->
      <pose>0.72 0.28 1.22 0 0.62 -2.72</pose>

      <link name="camera_link">
        <sensor name="rgb_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>

          <topic>/experiment3_camera/image_raw</topic>

          <camera>
            <horizontal_fov>0.80</horizontal_fov>

            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>

            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
